# ---------- Database (required) ----------
# Matches docker-compose.yml. Postgres 17 + pgvector.
DATABASE_URL="postgresql://estateai:estateai@localhost:5433/estateai?schema=public"

# ---------- LLM + Speech-to-Text (required for the agent) ----------
# https://console.groq.com/keys — used for chat completions (tool calling)
# and for Whisper transcription (whisper-large-v3-turbo).
GROQ_API_KEY=""
# Optional overrides
GROQ_MODEL="openai/gpt-oss-120b"
# ---------- Fallback LLM (optional) ----------
# Used when GROQ_MODEL is rate limited, and for end-of-call summaries.
# With GEMINI_API_KEY set, the default fallback is Gemini; otherwise Groq's
# openai/gpt-oss-20b (a separate per-model Groq quota).
# Get a key at https://aistudio.google.com/apikey
# Note: on Gemini's free tier Google may use prompts to improve its products;
# don't send real customer data through it without a paid plan.
GEMINI_API_KEY=""
# Comma-separated, tried in order. "gemini-*" names go to Google, others to Groq.
# LLM_FALLBACK_MODEL="gemini-2.5-flash,openai/gpt-oss-20b"
# LLM_SUMMARY_MODEL="gemini-2.5-flash"
# "none" disables Gemini thinking (fastest; works on gemini-2.5-flash). Use "low" for models that reject it.
# GEMINI_REASONING_EFFORT="none"
GROQ_STT_MODEL="whisper-large-v3-turbo"
# Optional: any OpenAI-compatible endpoint (default https://api.groq.com/openai/v1)
# GROQ_BASE_URL=""

# ---------- Text-to-Speech (optional) ----------
# https://platform.openai.com/api-keys — OpenAI TTS. If unset, the browser's
# built-in speechSynthesis voice is used instead (clearly labelled in the UI).
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"
# Optional: use OpenAI Whisper instead of Groq Whisper for STT ("groq" | "openai")
STT_PROVIDER="groq"

# ---------- Embeddings ----------
# Local sentence-transformer (runs in-process via @huggingface/transformers,
# downloaded once on first use, ~23 MB). No API key needed.
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
